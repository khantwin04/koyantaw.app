# Koyantaw landing page on Hostinger (LiteSpeed/Apache).
# Recreates what firebase.json used to do.

Options -Indexes
ErrorDocument 404 /404.html

# HTTPS only (.app is HSTS-preloaded, so browsers refuse plain HTTP anyway),
# and www -> apex so there is one canonical address.
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://koyantaw.app%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Fonts and images never change in place (rename to update), so cache for
  # a year. CSS/JS for an hour; HTML always revalidated.
  <FilesMatch "\.(otf|png|jpe?g|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
